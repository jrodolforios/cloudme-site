---
import type { Locale } from '@/config/site';
import type { NavContent } from '@/i18n/types';
import { alternateLocalePath } from '@/i18n';
import { withBase } from '@/lib/paths';

interface Props {
  locale: Locale;
  nav: NavContent;
  ctaHref: string;
}

const { locale, nav, ctaHref } = Astro.props;
const altHref = withBase(alternateLocalePath('home', locale));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={withBase(locale === 'pt' ? '/' : '/en/')} aria-label="CloudMe">
      <img src={withBase('/brand/logo-compact.svg')} width="132" height="38" alt="" loading="eager" />
      <span class="visually-hidden">CloudMe — {locale === 'pt' ? 'por Rodolfo Rios' : 'by Rodolfo Rios'}</span>
    </a>

    <nav class="site-header__nav" aria-label={locale === 'pt' ? 'Navegação principal' : 'Main navigation'}>
      <a href="#solutions">{nav.solutions}</a>
      <a href="#how-it-works">{nav.howItWorks}</a>
      <a href="#about">{nav.about}</a>
      <a href="#faq">{nav.faq}</a>
    </nav>

    <div class="site-header__actions">
      <a class="lang-switch tap-target" href={altHref} aria-label={nav.langSwitchLabel} hreflang={locale === 'pt' ? 'en' : 'pt-BR'}>
        {locale === 'pt' ? 'EN' : 'PT'}
      </a>
      <a class="cta-button cta-button--primary tap-target" href={ctaHref}>{nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--surface-light) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(10, 30, 70, 0.08);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-header__brand img {
    height: 32px;
    width: auto;
  }

  .site-header__nav {
    display: none;
    gap: var(--space-3);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--text-on-light);
    padding-block: var(--space-1);
  }

  .site-header__nav a:hover {
    color: var(--color-cloudme-blue);
  }

  @media (min-width: 860px) {
    .site-header__nav {
      display: flex;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-cloudme-blue);
    text-decoration: none;
    padding-inline: var(--space-1);
    border: 1px solid rgba(11, 61, 145, 0.35);
    border-radius: var(--radius-sm);
  }
</style>
