---
import type { AboutContent } from '@/i18n/types';

interface Props {
  content: AboutContent;
  resumeHref: string;
}

const { content, resumeHref } = Astro.props;
---

<section class="section section--alt" id="about">
  <div class="container about__grid">
    <div class="about__portrait reveal">
      <!--
        Retrato provisório. Ver `public/brand/README.md` para o ponto de
        substituição pela foto profissional real de Rodolfo Rios.
      -->
      <img
        src="/brand/rodolfo-placeholder.svg"
        width="320"
        height="320"
        alt="Retrato ilustrativo de Rodolfo Rios"
        loading="lazy"
      />
    </div>
    <div class="reveal">
      <h2 class="section-title">{content.title}</h2>
      {content.paragraphs.map((paragraph) => (
        <p class="about__paragraph">{paragraph}</p>
      ))}
      <a class="cta-button cta-button--secondary tap-target" href={resumeHref}>{content.cta}</a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: 0.7fr 1.3fr;
    }
  }

  .about__portrait img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  .about__paragraph {
    margin-block-start: var(--space-3);
    color: var(--text-on-light-muted);
    max-width: 60ch;
  }

  .about__paragraph:first-of-type {
    margin-block-start: var(--space-3);
  }

  .about__grid a.cta-button {
    margin-block-start: var(--space-4);
  }
</style>
