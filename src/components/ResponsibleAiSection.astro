---
import type { ResponsibleAiContent } from '@/i18n/types';

interface Props {
  content: ResponsibleAiContent;
}

const { content } = Astro.props;
---

<section class="section section--alt">
  <div class="container responsible">
    <div class="reveal">
      <h2 class="section-title">{content.title}</h2>
      <p class="responsible__intro">{content.intro}</p>
    </div>
    <ul class="responsible__list reveal">
      {content.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .responsible {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 860px) {
    .responsible {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .responsible__intro {
    margin-block-start: var(--space-3);
    max-width: 52ch;
    color: var(--text-on-light-muted);
  }

  .responsible__list {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .responsible__list li {
    background: var(--surface-light);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-weight: 600;
    box-shadow: var(--shadow-soft);
  }
</style>
